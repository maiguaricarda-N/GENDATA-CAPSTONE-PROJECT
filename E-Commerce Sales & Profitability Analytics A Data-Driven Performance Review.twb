              <zone h='6000' id='10' name='Revenue vs Dicscount by Category' param='[federated.042lfkd0rqc4py103ezla0qwvlf5].[attr:Category:nk]' type-v2='highlighter' w='49500' x='50000' y='42600'>
                <zone-style>
                  <format attr='border-color' value='#000000' />
