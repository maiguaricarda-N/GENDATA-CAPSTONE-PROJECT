    <dashboard enable-sort-zone-taborder='true' name='Dashboard 5'>
      <style />
      <size maxheight='900' maxwidth='1600' minheight='900' minwidth='1600' sizing-mode='fixed' />
      <zones>
        <zone h='100000' id='4' type-v2='layout-basic' w='100000' x='0' y='0'>
          <zone h='98222' id='3' param='horz' type-v2='layout-flow' w='49499' x='500' y='889'>
            <zone h='98222' id='5' param='vert' type-v2='layout-flow' w='49499' x='500' y='889'>
              <zone h='98218' id='7' name=' Estimated Profit Margin by Category' w='49499' x='500' y='889'>
                <layout-cache cell-count-h='7' minwidth='200' non-cell-size-h='148' type-h='cell' type-w='scalable' />
                <zone-style>
                  <format attr='border-color' value='#000000' />
