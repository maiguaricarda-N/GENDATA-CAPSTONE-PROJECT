    <dashboard name='Story 1' type='storyboard'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#b07aa1' fontname='Algerian' fontsize='20' underline='true'>GENDATA CAPSTONE PROJECT</run>
          </formatted-text>
        </title>
      </layout-options>
      <style>
        <style-rule element='table'>
          <format attr='background-color' value='#f7f1f6' />
        </style-rule>
        <style-rule element='story-description'>
