    <worksheet name='stock value by Revenue'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontalignment='1' fontcolor='#86bcb6' fontname='Algerian' underline='true'>STOCK VALUE BY REVENUE</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='CUSTOMERS+' name='federated.042lfkd0rqc4py103ezla0qwvlf5' />
          </datasources>
          <datasource-dependencies datasource='federated.042lfkd0rqc4py103ezla0qwvlf5'>
            <column datatype='string' name='[Brand]' role='dimension' type='nominal' />
            <column caption='Assumed Cost Ratio' datatype='real' name='[Calculation_0119064706420746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Category]&#13;&#10;WHEN &apos;Electronics&apos; THEN 0.75&#13;&#10;WHEN &apos;Fashion&apos; THEN 0.45&#13;&#10;WHEN &apos;Home&apos; THEN 0.55&#13;&#10;WHEN &apos;Beauty&apos; THEN 0.40&#13;&#10;WHEN &apos;Grocery&apos; THEN 0.65&#13;&#10;WHEN &apos;Books&apos; THEN 0.60&#13;&#10;WHEN &apos;Sports&apos; THEN 0.50&#13;&#10;ELSE 0.55&#13;&#10;END' />
            </column>
            <column caption='Estimated Cost Price' datatype='real' name='[Calculation_0119064707846155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Original_Price] * [Calculation_0119064706420746]' />
            </column>
            <column caption='Estimated Profit Margin.' datatype='real' name='[Calculation_0119064707932172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Selling_Price] - [Calculation_0119064707846155]) / [Selling_Price]' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Original Price' datatype='real' name='[Original_Price]' role='measure' type='quantitative' />
            <column caption='Selling Price' datatype='real' name='[Selling_Price]' role='measure' type='quantitative' />
            <column caption='Stock Quantity' datatype='integer' name='[Stock_Quantity]' role='measure' type='quantitative' />
            <column-instance column='[Brand]' derivation='None' name='[none:Brand:nk]' pivot='key' type='nominal' />
            <column-instance column='[Calculation_0119064707932172]' derivation='Sum' name='[sum:Calculation_0119064707932172:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Stock_Quantity]' derivation='Sum' name='[sum:Stock_Quantity:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <aggregation value='true' />
        </view>
        <style />
        <panes>
          <pane selection-relaxation-option='selection-relaxation-allow'>
            <view>
              <breakdown value='auto' />
            </view>
            <mark class='Automatic' />
            <encodings>
              <color column='[federated.042lfkd0rqc4py103ezla0qwvlf5].[sum:Calculation_0119064707932172:qk]' />
              <size column='[federated.042lfkd0rqc4py103ezla0qwvlf5].[sum:Stock_Quantity:qk]' />
              <lod column='[federated.042lfkd0rqc4py103ezla0qwvlf5].[none:Brand:nk]' />
              <text column='[federated.042lfkd0rqc4py103ezla0qwvlf5].[none:Brand:nk]' />
              <text column='[federated.042lfkd0rqc4py103ezla0qwvlf5].[sum:Stock_Quantity:qk]' />
              <text column='[federated.042lfkd0rqc4py103ezla0qwvlf5].[sum:Calculation_0119064707932172:qk]' />
            </encodings>
            <style>
              <style-rule element='mark'>
                <format attr='mark-labels-show' value='true' />
                <format attr='mark-labels-cull' value='true' />
              </style-rule>
            </style>
          </pane>
        </panes>
        <rows />
        <cols />
      </table>
