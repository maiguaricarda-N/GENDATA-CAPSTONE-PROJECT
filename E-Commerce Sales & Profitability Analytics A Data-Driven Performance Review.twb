          </datasources>
          <datasource-dependencies datasource='federated.042lfkd0rqc4py103ezla0qwvlf5'>
            <column caption='Net Revenue' datatype='real' name='[Calculation_0119064662609923]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Total_Amount] - [Coupon_Discount]' />
            </column>
            <column caption='Coupon Discount' datatype='real' name='[Coupon_Discount]' role='measure' type='quantitative' />
            <column caption='Total Amount' datatype='real' name='[Total_Amount]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_0119064662609923]' derivation='Sum' name='[sum:Calculation_0119064662609923:qk]' pivot='key' type='quantitative' />
