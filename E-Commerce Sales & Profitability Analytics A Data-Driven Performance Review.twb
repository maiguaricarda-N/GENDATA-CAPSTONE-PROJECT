          <zone h='98400' id='3' param='horz' type-v2='layout-flow' w='49500' x='50000' y='800'>
            <zone h='98400' id='6' param='vert' type-v2='layout-flow' w='49500' x='50000' y='800'>
              <zone h='20900' id='8' name='Revenue vs Dicscount by Category' pane-specification-id='1' param='[federated.042lfkd0rqc4py103ezla0qwvlf5].[none:Category:nk]' type-v2='color' w='49500' x='50000' y='800'>
                <zone-style>
