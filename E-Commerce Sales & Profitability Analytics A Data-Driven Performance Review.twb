              <calculation class='tableau' formula='[Total_Amount] - [Coupon_Discount]' />
            </column>
            <column caption='Assumed Cost Ratio' datatype='real' name='[Calculation_0119064706420746]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Category]&#13;&#10;WHEN &apos;Electronics&apos; THEN 0.75&#13;&#10;WHEN &apos;Fashion&apos; THEN 0.45&#13;&#10;WHEN &apos;Home&apos; THEN 0.55&#13;&#10;WHEN &apos;Beauty&apos; THEN 0.40&#13;&#10;WHEN &apos;Grocery&apos; THEN 0.65&#13;&#10;WHEN &apos;Books&apos; THEN 0.60&#13;&#10;WHEN &apos;Sports&apos; THEN 0.50&#13;&#10;ELSE 0.55&#13;&#10;END' />
            </column>
            <column caption='Estimated Cost Price' datatype='real' name='[Calculation_0119064707846155]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Original_Price] * [Calculation_0119064706420746]' />
            </column>
            <column caption='Estimated Profit Margin.' datatype='real' name='[Calculation_0119064707932172]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='([Selling_Price] - [Calculation_0119064707846155]) / [Selling_Price]' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Coupon Discount' datatype='real' name='[Coupon_Discount]' role='measure' type='quantitative' />
            <column caption='Discount Amount' datatype='real' name='[Discount_Amount]' role='measure' type='quantitative' />
            <column caption='Original Price' datatype='real' name='[Original_Price]' role='measure' type='quantitative' />
            <column caption='Selling Price' datatype='real' name='[Selling_Price]' role='measure' type='quantitative' />
            <column caption='Total Amount' datatype='real' name='[Total_Amount]' role='measure' type='quantitative' />
